/* Wallpaper palette is generated by wallpaper-theme.py. */
:root, ytmusic-app {
    --rice-bg: {{background}};
    --rice-surface: {{surface}};
    --rice-raised: {{surface_container}};
    --rice-text: {{on_surface}};
    --rice-muted: {{on_surface_variant}};
    --rice-accent: {{primary}};
    --rice-accent-text: {{on_primary_container}};
    --rice-selection: {{primary_container}};
    --rice-border: {{outline_variant}};
    --ytmusic-color-black1: var(--rice-bg);
    --ytmusic-color-black2: var(--rice-surface);
    --ytmusic-color-black3: var(--rice-raised);
    --ytmusic-color-black4: var(--rice-raised);
    --ytmusic-color-white1: var(--rice-text);
    --ytmusic-color-white2: var(--rice-muted);
    --ytmusic-color-white3: var(--rice-muted);
    --ytmusic-color-grey1: var(--rice-muted);
    --ytmusic-color-grey2: var(--rice-muted);
    --ytmusic-color-grey3: var(--rice-border);
    --ytmusic-color-grey4: var(--rice-raised);
    --ytmusic-color-grey5: var(--rice-surface);
    --ytmusic-color-brand: var(--rice-accent);
    --ytmusic-color-lightred: var(--rice-accent);
    --ytmusic-color-darkred: var(--rice-accent);
    --ytmusic-brand-color: var(--rice-accent);
    --ytmusic-general-background-a: var(--rice-bg);
    --ytmusic-general-background-b: var(--rice-surface);
    --ytmusic-general-background-c: var(--rice-raised);
    --ytmusic-primary-text-color: var(--rice-text);
    --ytmusic-secondary-text-color: var(--rice-muted);
    --yt-spec-text-primary: var(--rice-text);
    --yt-spec-text-secondary: var(--rice-muted);
    --yt-spec-base-background: var(--rice-bg);
    --yt-spec-raised-background: var(--rice-surface);
    --yt-spec-brand-background-primary: var(--rice-bg);
    --yt-spec-call-to-action: var(--rice-accent);
    --paper-slider-active-color: var(--rice-accent);
    --paper-slider-knob-color: var(--rice-accent);
    --paper-progress-active-color: var(--rice-accent);
    --paper-progress-container-color: var(--rice-border);
}

html, body, ytmusic-app {
    background: var(--rice-bg) !important;
    color: var(--rice-text) !important;
    font-family: "JetBrainsMono Nerd Font", "Noto Sans", sans-serif !important;
}

ytmusic-app :is(yt-formatted-string, input, textarea, button) {
    font-family: "JetBrainsMono Nerd Font", "Noto Sans", sans-serif !important;
}

ytmusic-nav-bar, ytmusic-player-bar, #guide-wrapper.ytmusic-app {
    background: var(--rice-surface) !important;
}
ytmusic-nav-bar { border-bottom: 1px solid var(--rice-border); }
ytmusic-player-bar { border-top: 1px solid var(--rice-border); }

ytmusic-search-box {
    --ytmusic-search-background: var(--rice-raised);
    --ytmusic-search-box-background: var(--rice-raised);
    border-radius: 10px;
}

ytmusic-two-row-item-renderer :is(yt-img-shadow, img),
ytmusic-player :is(yt-img-shadow, img) {
    border-radius: 10px;
}

ytmusic-responsive-list-item-renderer,
ytmusic-two-row-item-renderer,
ytmusic-guide-entry-renderer,
ytmusic-player-bar tp-yt-paper-icon-button {
    transition: background-color 160ms ease, color 160ms ease, box-shadow 160ms ease;
    border-radius: 5px;
}

ytmusic-responsive-list-item-renderer:hover,
ytmusic-guide-entry-renderer:hover {
    background-color: color-mix(in srgb, var(--rice-accent) 10%, transparent) !important;
}

ytmusic-guide-entry-renderer[active] {
    background-color: var(--rice-selection) !important;
    color: var(--rice-accent-text) !important;
}

ytmusic-player-bar tp-yt-paper-icon-button:hover {
    color: var(--rice-accent) !important;
    background: color-mix(in srgb, var(--rice-accent) 12%, transparent);
    box-shadow: 0 0 12px color-mix(in srgb, var(--rice-accent) 14%, transparent);
}

ytmusic-player-bar #play-pause-button { color: var(--rice-accent) !important; }
ytmusic-player-bar #progress-bar {
    --paper-slider-active-color: var(--rice-accent);
    --paper-slider-knob-color: var(--rice-accent);
    --paper-slider-container-color: var(--rice-border);
}

tp-yt-paper-dialog, ytmusic-menu-popup-renderer {
    background: var(--rice-surface) !important;
    color: var(--rice-text) !important;
    border: 1px solid var(--rice-border);
    border-radius: 10px;
}

::selection { background: var(--rice-selection); color: var(--rice-accent-text); }
::-webkit-scrollbar { width: 5px; height: 5px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: var(--rice-border); border-radius: 5px; }
::-webkit-scrollbar-thumb:hover { background: var(--rice-muted); }
