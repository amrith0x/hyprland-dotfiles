[global]
    follow = keyboard
    width = (320, 420)
    height = (0, 240)
    origin = top-right
    offset = (12, 48)
    notification_limit = 4
    gap_size = 8
    padding = 14
    horizontal_padding = 16
    text_icon_padding = 12
    frame_width = 2
    corner_radius = 5
    separator_height = 1
    separator_color = frame
    transparency = 0
    font = JetBrainsMono Nerd Font 10
    line_height = 3
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    word_wrap = yes
    ellipsize = end
    show_age_threshold = 60
    stack_duplicates = true
    hide_duplicate_count = false
    icon_position = left
    min_icon_size = 24
    max_icon_size = 36
    icon_theme = Papirus-Dark,Adwaita
    enable_recursive_icon_lookup = true
    progress_bar = true
    progress_bar_height = 6
    progress_bar_frame_width = 0
    progress_bar_corner_radius = 3
    mouse_left_click = close_current
    mouse_middle_click = do_action,close_current
    mouse_right_click = close_all

# Fallback colors; dunstrc.d/wallpaper-colors.conf overrides these automatically.
[urgency_low]
    background = "#1e1e2e"
    foreground = "#a6adc8"
    frame_color = "#45475a"
    highlight = "#89b4fa"
    timeout = 5

[urgency_normal]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    frame_color = "#89b4fa"
    highlight = "#89b4fa"
    timeout = 8

[urgency_critical]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    frame_color = "#f38ba8"
    highlight = "#f38ba8"
    timeout = 0
