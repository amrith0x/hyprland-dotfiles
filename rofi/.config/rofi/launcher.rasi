/* Fallbacks keep the launcher usable before the first palette generation. */
* {
    wp-background: #11111bb3;
    wp-surface: #1e1e2e;
    wp-foreground: #cdd6f4;
    wp-muted: #a6adc8;
    wp-accent: #89b4fa;
    wp-selection: #262b3d;
    wp-selected-text: #cdd6f4;
}
@import "wallpaper-colors.rasi"

* {
    font: "JetBrainsMono Nerd Font 11";
    background-color: transparent;
    text-color: @wp-foreground;
    border-color: @wp-accent;
    spacing: 8px;
}
window {
    location: center;
    anchor: center;
    width: calc(640px min 90%);
    border: 2px;
    border-radius: 5px;
    padding: 18px;
    background-color: @wp-background;
}
mainbox {
    children: [ inputbar, listview ];
    spacing: 14px;
}
inputbar {
    children: [ prompt, entry ];
    background-color: transparent;
    border-radius: 5px;
    padding: 12px 14px;
    spacing: 12px;
}
prompt { text-color: @wp-accent; }
entry {
    placeholder: "Search applications…";
    placeholder-color: @wp-muted;
    expand: true;
}
listview {
    columns: 1;
    lines: 7;
    fixed-height: true;
    dynamic: false;
    scrollbar: false;
    spacing: 4px;
}
element {
    children: [ element-icon, element-text ];
    padding: 10px 12px;
    spacing: 12px;
    border-radius: 5px;
}
element selected.normal, element selected.active {
    background-color: @wp-selection;
    text-color: @wp-selected-text;
}
element-icon {
    size: 28px;
    vertical-align: 0.5;
    background-color: inherit;
}
element-text {
    vertical-align: 0.5;
    background-color: inherit;
    text-color: inherit;
}
